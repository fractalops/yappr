#!/bin/sh
# Runs `yappr hook` for the yappr plugins of Claude Code and Codex.
# The Codex permission hook also requests a visible warning.
#
# Without yappr, this script writes an install hint to stderr and exits 0.
# The agent then asks for permission in the terminal as before.

# Claude Code gives the plugin options as CLAUDE_PLUGIN_OPTION_*. An empty
# option keeps the setting of `yappr config`.
if [ "$1" = claude ]; then
  if [ -n "${CLAUDE_PLUGIN_OPTION_DEVICE:-}" ]; then export YAPPR_HOOK_TO="$CLAUDE_PLUGIN_OPTION_DEVICE"; fi
  if [ -n "${CLAUDE_PLUGIN_OPTION_TIMEOUT:-}" ]; then export YAPPR_HOOK_TIMEOUT="$CLAUDE_PLUGIN_OPTION_TIMEOUT"; fi
  if [ -n "${CLAUDE_PLUGIN_OPTION_EVENTS:-}" ]; then export YAPPR_HOOK_EVENTS="$CLAUDE_PLUGIN_OPTION_EVENTS"; fi
  if [ -n "${CLAUDE_PLUGIN_OPTION_WHEN:-}" ]; then export YAPPR_HOOK_WHEN="$CLAUDE_PLUGIN_OPTION_WHEN"; fi
  if [ -n "${CLAUDE_PLUGIN_OPTION_FEED:-}" ]; then export YAPPR_FEED="$CLAUDE_PLUGIN_OPTION_FEED"; fi
fi

if [ -n "${YAPPR_BIN:-}" ]; then
  yappr=$YAPPR_BIN
elif command -v yappr >/dev/null 2>&1; then
  yappr=$(command -v yappr)
elif [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/yappr" ]; then
  yappr="${CARGO_HOME:-$HOME/.cargo}/bin/yappr"
else
  hint='yappr is not installed. Install it from https://github.com/fractalops/yappr#install'
  printf 'yappr hook: %s\n' "$hint" >&2
  cat >/dev/null
  if [ "$1" = codex ] && [ "${2:-}" = permission ]; then
    printf '{"systemMessage":"%s"}\n' "$hint"
  fi
  exit 0
fi

exec "$yappr" hook --agent "$1"
